# Copy this file to .env before running the agent.

# UperLevel API base URL. Hardcoded to local dev per the current rollout —
# change this to your real server address before deploying to real machines.
API_URL=http://127.0.0.1:8000

# Must match AGENT_SHARED_SECRET in the Laravel app's .env exactly.
AGENT_SECRET=

# How often to capture, in minutes. 5 matches the current rollout.
CAPTURE_INTERVAL_MINUTES=5

# Override the machine name the agent reports instead of using the real
# OS hostname — useful for testing multiple "employees" from one PC.
# MACHINE_NAME_OVERRIDE=
